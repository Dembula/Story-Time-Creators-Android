<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StoryTimeCreators" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Android 12+ system splash: orange field with the S.T logo, then hands off to the app theme. -->
    <style name="Theme.StoryTimeCreators.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/st_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.StoryTimeCreators</item>
    </style>
</resources>
